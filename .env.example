# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public project URL, e.g. https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Full DB + Auth Admin access. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute URL of the deployed site. Used for OAuth callbacks, emails, SEO.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Secret key (sk_test_... or sk_live_...). SERVER ONLY.
STRIPE_SECRET_KEY=

# Publishable key (pk_test_... or pk_live_...). Safe for browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...). SERVER ONLY. Required to verify webhooks.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Resend API key. SERVER ONLY.
RESEND_API_KEY=

# Default From address for transactional email, e.g. noreply@sprace.com
EMAIL_FROM_ADDRESS=noreply@sprace.com
